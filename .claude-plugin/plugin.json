{
  "name": "pdf-editor",
  "version": "0.2.0",
  "description": "Fill in and sign PDFs in chat: the assistant looks at each page, writes text, ticks and form values where it decides, shows the draft and signs with the operator's stored signature after their approval.",
  "author": {"name": "Nicola Bonzanni", "url": "https://github.com/bonzanni"},
  "homepage": "https://github.com/bonzanni/casa-plugin-pdf-editor",
  "repository": "https://github.com/bonzanni/casa-plugin-pdf-editor",
  "license": "AGPL-3.0-or-later",
  "keywords": ["casa", "pdf", "mcp"],
  "casa": {
    "provides_tools": [
      "mcp__plugin_pdf-editor_pdf-editor__open_pdf",
      "mcp__plugin_pdf-editor_pdf-editor__look_at_page",
      "mcp__plugin_pdf-editor_pdf-editor__write_on_pdf",
      "mcp__plugin_pdf-editor_pdf-editor__undo_last_write",
      "mcp__plugin_pdf-editor_pdf-editor__send_pdf_to_chat",
      "mcp__plugin_pdf-editor_pdf-editor__sign_pdf",
      "mcp__plugin_pdf-editor_pdf-editor__preview_signature",
      "mcp__plugin_pdf-editor_pdf-editor__store_signature",
      "mcp__plugin_pdf-editor_pdf-editor__signature_status",
      "mcp__plugin_pdf-editor_pdf-editor__remove_signature",
      "mcp__plugin_pdf-editor_pdf-editor__erase_pdf_editor",
      "mcp__plugin_pdf-editor_pdf-editor__erase_pdf_documents"
    ],
    "profiles": {
      "fill": ["open_pdf", "look_at_page", "write_on_pdf", "undo_last_write", "send_pdf_to_chat", "signature_status"]
    },
    "eraseTool": "erase_pdf_editor",
    "eraseDataOnlyTool": "erase_pdf_documents",
    "protectedTools": [
      {"name": "sign_pdf", "summary": "Sign {filename} (draft {version}) with the {look} signature"},
      {"name": "store_signature", "summary": "Store the signature just previewed ({preview_id}) as the one used for signing"},
      {"name": "remove_signature", "summary": "Delete the stored signature"},
      {"name": "erase_pdf_editor", "summary": "Deletes the stored signature and all working documents."},
      {"name": "erase_pdf_documents", "summary": "Deletes all working documents; keeps the stored signature."}
    ],
    "resultContract": {
      "version": 1,
      "tools": {
        "open_pdf": {"result": "safe"},
        "look_at_page": {"result": "safe"},
        "write_on_pdf": {"result": "safe"},
        "undo_last_write": {"result": "safe"},
        "send_pdf_to_chat": {"result": "capability", "provides": ["file"],
                             "delivers": {"file": "operator_file"}, "filename": true},
        "sign_pdf": {"result": "safe"},
        "preview_signature": {"result": "capability", "provides": ["file"],
                              "delivers": {"file": "operator_file"}, "filename": true},
        "store_signature": {"result": "safe"},
        "signature_status": {"result": "safe"},
        "remove_signature": {"result": "safe"},
        "erase_pdf_editor": {"result": "safe"},
        "erase_pdf_documents": {"result": "safe"}
      }
    }
  }
}
